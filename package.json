{
  "name": "lensui-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "ArdaBot, Inc.",
    "url": "https://www.ardabot.ai/"
  },
  "homepage": "https://lensui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardabotai/lensui.git"
  },
  "bugs": {
    "url": "https://github.com/ardabotai/lensui/issues"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter '!@ardabot/lensui' run build && node scripts/build-lensui-stage.mjs && pnpm --filter @ardabot/lensui run build",
    "build:site": "pnpm run build && node scripts/prepare-next-site.mjs && pnpm --filter @lensui/docs build && node scripts/build-site.mjs",
    "bench": "node scripts/bench-token-efficiency.mjs",
    "dev:site": "node scripts/prepare-next-site.mjs && pnpm --filter @lensui/docs dev",
    "e2e": "pnpm run build:site && playwright test",
    "e2e:install": "playwright install chromium",
    "pack:check": "node scripts/publish-npm.mjs --dry-run",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:packages": "node scripts/publish-npm.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "4.1.6",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
